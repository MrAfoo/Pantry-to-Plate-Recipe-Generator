# ============================================================
#  Pantry to Plate — Environment Variables Template
#  Copy this file to .env.local and fill in your real values.
#  NEVER commit your .env.local file to version control.
# ============================================================

# Groq API Key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: AI Model Overrides
# Vision model (must support image input — only qwen/qwen3.8-27b available on Groq free tier)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Chat model for recipe generation & substitutes (text-only, separate rate limit bucket)
# GROQ_CHAT_MODEL=openai/gpt-oss-20b

# ============================================================
#  Upstash Redis — Persistent recipe ratings
#  Create a free database at https://console.upstash.com
#  Then copy the REST URL and token from the database dashboard.
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
